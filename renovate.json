{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>edbfi/automation//default.json#v3.0.1"],
  "automerge": true,
  "automergeStrategy": "rebase",
  "automergeType": "pr",
  "platformAutomerge": false,
  "ignoreTests": false,
  "packageRules": [
    {
      "description": "Keep direct npm versions exact: post-artifact minimumReleaseAge re-extraction is unavailable (renovatebot/renovate#45284).",
      "matchManagers": ["npm", "bun"],
      "rangeStrategy": "pin"
    }
  ]
}
